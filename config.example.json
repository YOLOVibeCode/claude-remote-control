{
  "alerts": {
    "provider": "noctusoft-relay",
    "to": "+15125550100",
    "env": {
      "api_key": "NOCTUSOFT_API_KEY"
    }
  },
  "report": {
    "provider": "noctusoft-relay",
    "to": "you@example.com",
    "env": {
      "api_key": "NOCTUSOFT_API_KEY"
    }
  },
  "heartbeat": {
    "provider": "http",
    "env": {
      "token": "CLAUDE_RC_HEARTBEAT_TOKEN"
    },
    "options": {
      "url": "https://<your-always-on-service>/v1/heartbeat"
    }
  },
  "policy": {
    "_comment": "Off until enabled. Preview with: claude-rc plan, claude-rc plan --at 1",
    "enabled": false,
    "night_start_hour": 0,
    "night_end_hour": 6,
    "idle_park_hours": 8,
    "night_idle_minutes": 30,
    "max_live": 8,
    "budget_min_idle_minutes": 60,
    "throttle_at_night": true,
    "morning_revive": false
  },
  "door": {
    "_comment": "One always-on 'claude remote-control' server in tmux session 'remote'",
    "enabled": false,
    "session": "remote",
    "name": "",
    "dir": "~/Dev",
    "spawn": "same-dir",
    "capacity": 2,
    "permission_mode": "acceptEdits"
  },
  "_other_providers": {
    "twilio (alerts)": {
      "provider": "twilio",
      "to": "+15125550100",
      "env": {
        "account_sid": "TWILIO_ACCOUNT_SID",
        "auth_token": "TWILIO_AUTH_TOKEN",
        "from": "TWILIO_FROM"
      }
    },
    "smtp (report)": {
      "provider": "smtp",
      "to": "you@example.com",
      "env": {
        "username": "SMTP_USER",
        "password": "SMTP_PASSWORD"
      },
      "options": {
        "host": "smtp.gmail.com",
        "port": 587,
        "from": "you@example.com"
      }
    },
    "sendgrid (report)": {
      "provider": "sendgrid",
      "to": "you@example.com",
      "env": {
        "api_key": "SENDGRID_API_KEY"
      },
      "options": {
        "from": "alerts@example.com"
      }
    },
    "console (either)": {
      "provider": "console",
      "to": "-"
    }
  }
}
